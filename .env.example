# --- LLM provider -----------------------------------------------------------
# Without a key the platform still runs: routing falls back to a keyword
# heuristic and reports are assembled from the retrieved evidence (no LLM call).
ANTHROPIC_API_KEY=
# Optional: Anthropic-compatible proxy / gateway
# ANTHROPIC_BASE_URL=
DEFAULT_MODEL=claude-sonnet-5-5

# --- Database ---------------------------------------------------------------
# PostgreSQL + pgvector. If unreachable the app falls back to a local SQLite file.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/resolveai

# --- Retrieval --------------------------------------------------------------
EMBEDDING_DIM=512

# --- MCP server -------------------------------------------------------------
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# --- API --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
APP_ENV=development
LOG_LEVEL=INFO
