# API Key (Can be Anthropic API Key or Omniroute API Key)
ANTHROPIC_API_KEY=your_api_key_here

# Optional Custom Base URL (e.g. for Omniroute proxy / custom endpoints)
ANTHROPIC_BASE_URL=https://api.omniroute.ai/v1

# Database Configuration
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/resolveai

# MCP Server Configuration
MCP_SERVER_PORT=8001

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_MODEL=anthropic/claude-opus-5-5
