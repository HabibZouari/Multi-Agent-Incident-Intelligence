# Copy to `.env` (git-ignored) and fill in your own values. Never commit `.env`.

# --- LLM provider -----------------------------------------------------------
# Without a key the platform still runs: routing falls back to a keyword
# heuristic and reports are assembled from the retrieved evidence (no LLM call).
ANTHROPIC_API_KEY=
# Optional: Anthropic-compatible proxy / gateway
# ANTHROPIC_BASE_URL=
DEFAULT_MODEL=claude-sonnet-5-5

# --- Database ---------------------------------------------------------------
# Local runs: leave DATABASE_URL unset to use a local SQLite file, or point it at your own
# PostgreSQL + pgvector server, e.g. postgresql://USER:PASSWORD@localhost:5432/resolveai
# DATABASE_URL=

# Docker Compose creates the PostgreSQL role from these. POSTGRES_PASSWORD is required:
# pick your own strong password (letters and digits keep the connection URL simple).
POSTGRES_USER=resolveai
POSTGRES_DB=resolveai
POSTGRES_PASSWORD=

# --- API protection ---------------------------------------------------------
# When set, every /api/* call must send this value in the X-API-Key header (the Streamlit UI
# does so automatically). Leave empty for local development; set it for any shared deployment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- Retrieval --------------------------------------------------------------
EMBEDDING_DIM=512

# --- MCP server -------------------------------------------------------------
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# --- App --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
APP_ENV=development
LOG_LEVEL=INFO
